DATABASE_URL=postgres://localhost:5432/eri
# Optional live providers — leave blank to use the built-in simulators.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Auth ---
# Secret used to sign session cookies. Set a long random value (openssl rand -hex 32) for any real deployment.
AUTH_SECRET=
# 1 = show the SMS verification code on screen while SMS delivery is simulated (no Africa's Talking keys). Set to 0 once real SMS is connected.
SHOW_SMS_CODES=1
# Model used for photo reading and figure extraction when only OPENAI_API_KEY is set (default gpt-4o).
OPENAI_MODEL=
# Optional: shared secret the SMS/USSD provider must send as header x-webhook-secret or ?key=
WEBHOOK_SECRET=
# Set to 1 when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=0

# Optional: where uploaded EC8A photos are stored (default ./data/uploads; falls back to the temp dir on read-only hosts)
UPLOAD_DIR=
